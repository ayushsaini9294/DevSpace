// Cloudflare settings for the demo site (a static build of the web app with sample data; no
// server code). `npx wrangler deploy` builds the demo itself (the "build" command below), so it
// works whatever build command the Cloudflare project has.
{
  "name": "devspace",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "VITE_DEMO=1 VITE_DEMO_REPO_URL=https://github.com/ayushsaini9294/DevSpace npm run build -w @devspace/web",
  },
  "assets": {
    "directory": "./apps/web/dist",
    // Any path that isn't a file is a page of the app: serve index.html.
    "not_found_handling": "single-page-application",
  },
}
