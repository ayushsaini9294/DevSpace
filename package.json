{
  "name": "devspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "docker/ide/tracker"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,worker -c blue,magenta,green \"npm run dev -w @devspace/api\" \"npm run dev -w @devspace/web\" \"npm run dev -w @devspace/worker\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @devspace/api",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @devspace/api",
    "ide:build": "npm run build -w devspace-tracker && docker build -t devspace-ide:5 docker/ide",
    "templates:smoke": "bash scripts/template-smoke.sh",
    "ide:network": "bash scripts/ide-network.sh",
    "ports:check": "bash scripts/check-ports.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
