# DevSpace production settings. deploy/host-setup.sh copies this file to deploy/.env (readable only
# by root) and fills in DOCKER_GID, POSTGRES_PASSWORD and AI_SECRETS_KEY for you. Then fill in the
# rest by hand. Never commit deploy/.env, and never put real values in this example file.
# docs/deploy.md walks through every setting.

# Lets a plain `docker compose …` in deploy/ use the production file.
COMPOSE_FILE=compose.prod.yml

# ---- Your two domains (both on Cloudflare) ----
# The app's address, e.g. devspace.example.com or devspace.app. People open https://<APP_DOMAIN>.
APP_DOMAIN=
# The IDEs' domain: a DIFFERENT domain you own, not a subdomain of APP_DOMAIN (a subdomain would
# share the app's cookies). Every copy's IDE gets https://<copy id>.<IDE_DOMAIN>.
IDE_DOMAIN=
# Your email address, for Let's Encrypt (certificate expiry notices only).
ACME_EMAIL=
# A Cloudflare API token with Zone > DNS > Edit and Zone > Zone > Read on the IDE domain's zone.
# Caddy uses it to get the IDEs' wildcard certificate.
CLOUDFLARE_API_TOKEN=

# ---- Secrets (host-setup.sh makes these; keep them safe and never change them afterwards) ----
# The database password. Make one by hand with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Encrypts members' stored OpenRouter keys. Changing it means everyone connects OpenRouter again.
# Make one by hand with: openssl rand -base64 32
AI_SECRETS_KEY=

# ---- Docker ----
# The group id of /var/run/docker.sock on this server (host-setup.sh fills it in:
# stat -c %g /var/run/docker.sock). The API needs it to start IDE containers.
DOCKER_GID=

# ---- Folders on the server ----
# Members' copies and the projects' Git repositories (owned by uid 10001, made by host-setup.sh).
DATA_DIR=/srv/devspace/data
# Nightly backups (made by host-setup.sh).
BACKUP_DIR=/srv/devspace/backups
# How many nightly backups to keep, and when to make them (cron format, server time).
BACKUP_KEEP=7
BACKUP_SCHEDULE=0 3 * * *

# ---- GitHub (optional) ----
# Leave these empty and every GitHub feature says "GitHub isn't set up on this DevSpace yet".
# GITHUB_APP_PRIVATE_KEY_FILE is the path of the app's .pem file ON THIS SERVER, e.g.
# /srv/devspace/secrets/github-app.pem, owned by uid 10001 with mode 400 (docs/deploy.md).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=

# ---- AI models (optional) ----
# Comma-separated OpenRouter model ids for cross-reviews and their fallbacks. Empty = DevSpace's
# defaults. Members connect their own OpenRouter keys in DevSpace.
AI_DEFAULT_MODELS=
AI_FALLBACK_MODELS=

# ---- Ports on 127.0.0.1 (only change these if something else on the server uses them) ----
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=3000
# IDE_PORT=3100
