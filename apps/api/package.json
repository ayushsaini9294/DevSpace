{
  "name": "@devspace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./housekeeping": "./src/housekeeping/index.ts",
    "./prisma": "./src/lib/prisma.ts",
    "./copy-updates": "./src/jobs/worker-exports.ts",
    "./ai-reviews": "./src/jobs/ai-worker-exports.ts",
    "./github-sync": "./src/jobs/github-worker-exports.ts"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@devspace/shared": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "ignore": "^7.0.10",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
