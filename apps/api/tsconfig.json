{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // The worker's production build type-checks against dist/*.d.ts.
    "declaration": true
  },
  "include": ["src"]
}
