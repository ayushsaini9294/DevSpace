// Prisma schema for the DevSpace API.
// Connection URL lives in prisma.config.ts; the runtime client uses the pg driver adapter.
// Tables and columns are snake_case in PostgreSQL (via @@map/@map), camelCase in TypeScript.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(uuid())
  name                String
  /// Always stored lowercased (the shared Zod schema lowercases it).
  email               String          @unique
  /// Self-describing scrypt string: scrypt$N$r$p$<salt b64>$<hash b64>. Never returned by the API.
  passwordHash        String          @map("password_hash")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  sessions            Session[]
  ownedTeams          Team[]
  teamMemberships     TeamMember[]
  projectMemberships  ProjectMember[]
  invitationsSent     Invitation[]    @relation("InvitedBy")
  invitationsAccepted Invitation[]    @relation("AcceptedBy")
  activity            ActivityLog[]
  copies              Copy[]
  ideTickets          IdeTicket[]
  ideSessions         IdeSession[]
  submissions         Submission[]
  reviews             Review[]
  comments            Comment[]
  mergedSubmissions   Submission[]    @relation("MergedBy")
  revertedSubmissions Submission[]    @relation("RevertedBy")
  createdTasks        Task[]          @relation("TaskCreatedBy")
  taskAssignments     TaskAssignee[]
  notifications       Notification[]
  /// Share which file I have open with teammates (Phase 9 presence). Off → file is always null.
  shareOpenFile       Boolean         @default(true) @map("share_open_file")
  /// When the member accepted the one-time AI review notice (Phase 10); null = not yet.
  aiNoticeAcceptedAt  DateTime?       @map("ai_notice_accepted_at")
  aiConnection        AiConnection?
  aiOAuthStates       AiOAuthState[]
  aiReviews           AiReview[]

  @@map("users")
}

model Session {
  /// SHA-256 hex hash of the session token; the token itself is only in the cookie.
  id            String         @id
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime       @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  aiOAuthStates AiOAuthState[]

  @@index([userId])
  @@map("sessions")
}

// ---------- Phase 3: teams, projects, invitations, activity ----------

model Team {
  id        String       @id @default(uuid())
  name      String
  ownerId   String       @map("owner_id")
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now()) @map("created_at")
  members   TeamMember[]
  projects  Project[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id")
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Project {
  id            String          @id @default(uuid())
  teamId        String          @map("team_id")
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name          String
  /// Absolute path of the project's bare git repo on disk (set when the repository is set up).
  repoPath      String?         @map("repo_path")
  repoStatus    RepoStatus      @default(none) @map("repo_status")
  repoSource    RepoSource?     @map("repo_source")
  /// The starter template main began from (TemplateIdSchema), when repoSource is `template`.
  template      String?
  /// Normalized https link the repository was imported from (ImportUrlSchema).
  importUrl     String?         @map("import_url")
  /// Why the last import failed, in plain words.
  repoError     String?         @map("repo_error")
  /// ProjectSettings from packages/shared; validated with ProjectSettingsSchema when read.
  settings      Json
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  members       ProjectMember[]
  invitations   Invitation[]
  activity      ActivityLog[]
  copies        Copy[]
  submissions   Submission[]
  tasks         Task[]
  notifications Notification[]

  @@index([teamId])
  @@map("projects")
}

enum RepoStatus {
  none
  importing
  ready
  failed

  @@map("repo_status")
}

enum RepoSource {
  empty
  import
  template

  @@map("repo_source")
}

enum ProjectRole {
  leader
  co_leader
  member

  @@map("project_role")
}

model ProjectMember {
  projectId   String      @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ProjectRole
  /// MemberPermissions from packages/shared; validated with MemberPermissionsSchema when read.
  permissions Json
  joinedAt    DateTime    @default(now()) @map("joined_at")
  /// Last time this member was seen in the project (app socket or IDE), written at most once a minute.
  lastSeenAt  DateTime?   @map("last_seen_at")
  /// The last time this member launched a Preview of their app (getting-started step `preview`).
  previewedAt            DateTime? @map("previewed_at")
  /// Set while this member has hidden the getting-started card (Phase 11).
  gettingStartedHiddenAt DateTime? @map("getting_started_hidden_at")

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum InvitationStatus {
  pending
  accepted
  revoked

  @@map("invitation_status")
}

model Invitation {
  id           String           @id @default(uuid())
  projectId    String           @map("project_id")
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Always lowercased.
  email        String
  /// SHA-256 hex hash of the link token; the token itself is never stored.
  tokenHash    String           @unique @map("token_hash")
  invitedById  String           @map("invited_by_id")
  invitedBy    User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  status       InvitationStatus @default(pending)
  expiresAt    DateTime         @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  acceptedAt   DateTime?        @map("accepted_at")
  acceptedById String?          @map("accepted_by_id")
  acceptedBy   User?            @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([projectId, email])
  @@map("invitations")
}

/// Append-only: rows are only ever inserted by application code.
model ActivityLog {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("activity_log")
}

// ---------- Phase 5: copies ----------

/// A member's own working copy of a project: a git clone of the bare repo on its own branch,
/// stored at <COPIES_DIR>/<projectId>/<id> (computed, never stored or sent to clients).
model Copy {
  id                   String              @id @default(uuid())
  projectId            String              @map("project_id")
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId               String              @map("user_id")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `copy/<userId>`, branched from main when the copy was made.
  branchName           String              @map("branch_name")
  /// The IDE container's Docker id (named devspace-ide-<id>); null before the first start.
  /// Its connection token is never stored here: it lives only in the container's settings
  /// (root-only on the Docker host) and in the API's memory.
  containerId          String?             @map("container_id")
  containerStatus      CopyContainerStatus @default(none) @map("container_status")
  /// Why the last IDE start failed (for logs and support; never sent to the browser).
  containerError       String?             @map("container_error")
  /// When the IDE last started or carried traffic (updated at most every 30 s).
  lastActiveAt         DateTime?           @map("last_active_at")
  /// The copy folder's size on disk in bytes at the last check by the worker (null: never checked).
  diskBytes            BigInt?             @map("disk_bytes")
  diskCheckedAt        DateTime?           @map("disk_checked_at")
  /// True while the folder is over the 5 GB limit (set by the worker; not shown in the app yet).
  overDiskLimit        Boolean             @default(false) @map("over_disk_limit")
  /// The main commit this copy was made from (Phase 7 moves it when the copy is updated).
  /// Submissions are compared with it. Null only for copies made before Phase 6 until first
  /// use, when it is filled with the project's current main (exact: nothing had merged yet).
  baseSha              String?             @map("base_sha")
  /// Files a copy update wrote conflict markers into (Phase 7); pruned once resolved.
  markerPaths          String[]            @default([]) @map("marker_paths")
  /// Automatic mode found these conflicts and left the copy untouched (cleared by an update).
  pendingConflictPaths String[]            @default([]) @map("pending_conflict_paths")
  /// An update brought a package.json / package-lock.json change from main (Phase 9); cleared on dismiss.
  packagesChangedAt    DateTime?           @map("packages_changed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  ideTickets           IdeTicket[]
  ideSessions          IdeSession[]
  submissions          Submission[]

  @@unique([projectId, userId])
  @@index([userId])
  @@map("copies")
}

enum CopyContainerStatus {
  none
  starting
  running
  stopped
  failed

  @@map("copy_container_status")
}

// ---------- Phase 5.3b: the IDE on its own site ----------

/// A one-time IDE launch ticket (60 s). Stored only as the SHA-256 hex hash of the ticket that
/// travels in the launch URL; deleted when used.
model IdeTicket {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  copyId    String   @map("copy_id")
  copy      Copy     @relation(fields: [copyId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([userId])
  @@index([copyId])
  @@map("ide_tickets")
}

/// What the IDE site's `devspace_ide` cookie stands for (12 h): one user in one copy. Stored
/// only as the SHA-256 hex hash of the cookie's value.
model IdeSession {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  copyId    String   @map("copy_id")
  copy      Copy     @relation(fields: [copyId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([userId])
  @@index([copyId])
  @@map("ide_sessions")
}

// ---------- Phase 6: submissions and review ----------

enum SubmissionStatus {
  open
  changes_requested
  approved
  needs_update
  merged
  rejected
  closed
  reverted

  @@map("submission_status")
}

enum FileChange {
  added
  modified
  deleted

  @@map("file_change")
}

enum ReviewDecision {
  approved
  changes_requested

  @@map("review_decision")
}

enum DiffSide {
  base
  head

  @@map("diff_side")
}

enum SuggestionStatus {
  pending
  accepted
  rejected

  @@map("suggestion_status")
}

/// Work a member submitted from their copy. Each version's snapshot commit lives in the bare
/// repo at refs/submissions/<id>/v<version>; file contents are never stored here.
model Submission {
  id            String           @id @default(uuid())
  projectId     String           @map("project_id")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  copyId        String           @map("copy_id")
  copy          Copy             @relation(fields: [copyId], references: [id], onDelete: Cascade)
  authorId      String           @map("author_id")
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// The linked task (Phase 8); cleared when the task is deleted.
  taskId        String?          @map("task_id")
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title         String
  description   String           @default("")
  baseSha       String           @map("base_sha")
  headSha       String           @map("head_sha")
  version       Int              @default(1)
  status        SubmissionStatus @default(open)
  rejectReason  String?          @map("reject_reason")
  mergedSha     String?          @map("merged_sha")
  /// Files that conflict with the current main (set by the conflict re-check, Phase 7).
  conflictPaths String[]         @default([]) @map("conflict_paths")
  mergedById    String?          @map("merged_by_id")
  mergedBy      User?            @relation("MergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  mergedAt      DateTime?        @map("merged_at")
  revertedSha   String?          @map("reverted_sha")
  revertedById  String?          @map("reverted_by_id")
  revertedBy    User?            @relation("RevertedBy", fields: [revertedById], references: [id], onDelete: SetNull)
  revertedAt    DateTime?        @map("reverted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  closedAt      DateTime?        @map("closed_at")
  files         SubmissionFile[]
  reviews       Review[]
  comments      Comment[]
  aiReviews     AiReview[]

  @@index([projectId, createdAt])
  @@index([copyId, status])
  @@index([authorId])
  @@index([projectId, status])
  @@index([taskId])
  @@map("submissions")
}

/// The files in a submission's current version.
model SubmissionFile {
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  path         String
  change       FileChange

  @@id([submissionId, path])
  @@map("submission_files")
}

model Review {
  id           String         @id @default(uuid())
  submissionId String         @map("submission_id")
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String         @map("reviewer_id")
  reviewer     User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  decision     ReviewDecision
  body         String?
  /// The submission version reviewed; stale once the submission's version is higher.
  version      Int
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([reviewerId])
  @@map("reviews")
}

model Comment {
  id               String            @id @default(uuid())
  submissionId     String            @map("submission_id")
  submission       Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId         String            @map("author_id")
  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// A reply (one level deep).
  parentId         String?           @map("parent_id")
  parent           Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]         @relation("Replies")
  /// path, side, line and startLine are all null for a general comment or a reply.
  path             String?
  side             DiffSide?
  line             Int?
  startLine        Int?              @map("start_line")
  /// The text of `line` when the comment was written (for "outdated").
  lineText         String?           @map("line_text")
  version          Int
  body             String
  /// Replacement text for lines startLine..line on the head side.
  suggestion       String?
  suggestionStatus SuggestionStatus? @map("suggestion_status")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([submissionId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

// ---------- Phase 8: tasks ----------

enum TaskStatus {
  todo
  in_progress
  in_review
  done

  @@map("task_status")
}

/// A card on the project's task board. Its column moves by hand (TaskAssignee members between
/// todo and in_progress; leaders and co-leaders anywhere) and automatically with its linked
/// submissions (tasks/automatic.ts).
model Task {
  id                 String         @id @default(uuid())
  projectId          String         @map("project_id")
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String         @default("")
  status             TaskStatus     @default(todo)
  /// A calendar date (no time zone).
  dueDate            DateTime?      @map("due_date") @db.Date
  createdById        String         @map("created_by_id")
  createdBy          User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  /// Order inside its column (lower first).
  position           Float          @default(0)
  /// A linked submission was merged and a leader hasn't answered "Mark this task done?" yet.
  doneConfirmPending Boolean        @default(false) @map("done_confirm_pending")
  /// Why the task was reopened automatically; cleared by the next manual move or confirmation.
  reopenNote         String?        @map("reopen_note")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  completedAt        DateTime?      @map("completed_at")
  assignees          TaskAssignee[]
  submissions        Submission[]

  @@index([projectId, status, position])
  @@index([createdById])
  @@map("tasks")
}

/// 1–10 per task, all current project members (removing a member removes their assignments).
model TaskAssignee {
  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

// ---------- Phase 9: notifications ----------

/// An in-app notification for one user (never the person who caused it). `type` and `data`
/// follow NotificationDataSchemas in packages/shared. Deleted after 30 days by the worker, and
/// when the user is removed from the project.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?   @map("project_id")
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([projectId, userId])
  @@index([createdAt])
  @@map("notifications")
}

// ---------- Phase 10: AI review ----------

/// A member's OpenRouter connection. The key is encrypted with AES-256-GCM (AI_SECRETS_KEY,
/// random IV per value: see ai/crypto.ts) and never leaves the server.
model AiConnection {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("openrouter")
  encryptedKey String   @map("encrypted_key")
  /// The key's last 4 characters.
  keyHint      String   @map("key_hint")
  connectedAt  DateTime @default(now()) @map("connected_at")

  @@map("ai_connections")
}

/// A pending OpenRouter login (PKCE): single use, 10 minutes, bound to one app session. Stored
/// by the SHA-256 hex hash of the state; the verifier is encrypted like keys.
model AiOAuthState {
  id                String   @id
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String   @map("session_id")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  encryptedVerifier String   @map("encrypted_verifier")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("ai_oauth_states")
}

enum AiReviewSource {
  auto
  ide

  @@map("ai_review_source")
}

enum AiReviewStatus {
  queued
  running
  done
  failed

  @@map("ai_review_status")
}

/// One model's review of one submission version (a cross-review makes one per model; the IDE
/// command makes one with source ide). findings follows AiFindingSchema[] in packages/shared.
model AiReview {
  id             String         @id @default(uuid())
  submissionId   String         @map("submission_id")
  submission     Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version        Int
  requestedById  String         @map("requested_by_id")
  requestedBy    User           @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  /// The reviews made by one cross-review request share it (one notification when all finish).
  batchId        String?        @map("batch_id")
  source         AiReviewSource
  /// The model that answered (a fallback if needed); for ide: "IDE AI (reported by <name>)".
  model          String
  requestedModel String         @map("requested_model")
  isFree         Boolean?       @map("is_free")
  status         AiReviewStatus @default(queued)
  findings       Json           @default("[]")
  parseError     Boolean        @default(false) @map("parse_error")
  /// The model's answer (at most 100 KB). Untrusted: shown as plain text only.
  raw            String?
  error          String?
  errorCode      String?        @map("error_code")
  createdAt      DateTime       @default(now()) @map("created_at")
  startedAt      DateTime?      @map("started_at")
  finishedAt     DateTime?      @map("finished_at")

  @@index([submissionId, createdAt])
  @@index([requestedById, status])
  @@index([batchId])
  @@map("ai_reviews")
}
