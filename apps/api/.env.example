DATABASE_URL=postgresql://devspace:devspace@localhost:5432/devspace
PORT=3000
# Optional: where project Git repositories are stored (default: <repo root>/.data/repos)
# REPOS_DIR=
# Optional: where members' working copies are stored (default: <repo root>/.data/copies)
# COPIES_DIR=
# Optional: Docker's local socket (default: /var/run/docker.sock; never a TCP address)
# DOCKER_SOCKET=
# Optional: the IDE image and the network IDE containers join (defaults: devspace-ide:1, devspace-ide)
# IDE_IMAGE=
# IDE_NETWORK=
