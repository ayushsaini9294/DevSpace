DATABASE_URL=postgresql://devspace:devspace@localhost:5432/devspace
PORT=3000
# The worker (apps/worker) reads this file too. Optional: its Redis (default: redis://localhost:6379)
# REDIS_URL=
# Optional: where project Git repositories are stored (default: <repo root>/.data/repos)
# REPOS_DIR=
# Optional: where members' working copies are stored (default: <repo root>/.data/copies)
# COPIES_DIR=
# Optional: Docker's local socket (default: /var/run/docker.sock; never a TCP address)
# DOCKER_SOCKET=
# Optional: the IDE image and the network IDE containers join (defaults: devspace-ide:5, devspace-ide)
# IDE_IMAGE=
# IDE_NETWORK=
# The IDE is served by a second listener on its own site (never the app's origin).
# IDE_PORT/IDE_HOST: where that listener binds. IDE_ORIGIN: its public address. APP_ORIGIN: the
# web app's public address (the only page allowed to frame the IDE or send non-GET /api requests).
# IDE_ORIGIN must be on a different host from APP_ORIGIN (127.0.0.1 vs localhost in development).
IDE_PORT=3100
IDE_HOST=127.0.0.1
IDE_ORIGIN=http://127.0.0.1:3100
APP_ORIGIN=http://localhost:5173
# Required: encrypts members' stored OpenRouter keys (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# The API and the worker refuse to start without it. Keep it: changing it means everyone must
# connect OpenRouter again. Never commit a real one.
# AI_SECRETS_KEY=<paste yours here, or append it as the README shows>
# Optional: OpenRouter's address (default https://openrouter.ai; e2e tests use a stand-in server)
# OPENROUTER_BASE_URL=
# Optional: comma-separated model ids for cross-reviews, and the fallbacks tried in order
# AI_DEFAULT_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# AI_FALLBACK_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# Optional: the AI gateway (Phase 12) that IDE assistants call. It binds only this address, the
# devspace-ide network's gateway on the host (made by npm run ide:network); containers reach it
# at http://<AI_GATEWAY_HOST>:<AI_GATEWAY_PORT>/v1. Defaults: 10.213.0.1 and 3200.
# AI_GATEWAY_HOST=
# AI_GATEWAY_PORT=
# Optional: GitHub (Phase 13), through DevSpace's own GitHub App. Leave these unset and every
# GitHub feature says "GitHub isn't set up on this DevSpace yet". The worker needs the same values.
# Never commit the client secret or the private key; keep the .pem file outside the repository.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY_PATH=/home/you/secrets/devspace-github-app.pem
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional: GitHub's addresses (defaults https://api.github.com and https://github.com; e2e tests
# use a stand-in server). Plain http:// is refused unless GITHUB_ALLOW_HTTP=1 (stand-in only).
# GITHUB_API_URL=
# GITHUB_WEB_URL=
# GITHUB_ALLOW_HTTP=
